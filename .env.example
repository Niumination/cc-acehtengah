# ─── Database ───
# PostgreSQL connection (wajib untuk auth, laporan AI, dan sinkronisasi dataset)
# Vercel + Supabase: WAJIB pakai Supavisor pooler (IPv4), bukan direct connection.
#   postgresql://postgres.<ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&prepared_statements=false
DATABASE_URL="postgresql://user:password@localhost:5432/cc_acehtengah"

# ─── Auth (WAJIB) ───
# Tidak ada nilai default. Tanpa ini, semua endpoint auth menolak request
# (fail closed) — ini disengaja, lihat LAPORAN_AUDIT_PRODUCTION_READINESS.md §P0-01.
# Generate: openssl rand -base64 48      (minimal 32 karakter)
JWT_SECRET=""

# ─── Bootstrap admin pertama (HANYA saat setup awal) ───
# Endpoint /api/setup dan /api/setup/admin membalas 404 kecuali ketiga syarat terpenuhi:
#   1) SETUP_ENABLED=true
#   2) header  x-setup-token: <SETUP_TOKEN>   (SETUP_TOKEN minimal 32 karakter)
#   3) ADMIN_BOOTSTRAP_PASSWORD terisi (minimal 12 karakter)
# WAJIB dikembalikan ke false setelah akun pertama dibuat.
SETUP_ENABLED=false
# SETUP_TOKEN=""                    # openssl rand -hex 32
# ADMIN_BOOTSTRAP_USERNAME=admin
# ADMIN_BOOTSTRAP_PASSWORD=""

# ─── SPLP / SAPA Integration ───
# SAPA SPLP nasional bersifat publik (tanpa auth) dan dipakai sebagai fallback.
# Direct API kabupaten memakai OAuth client_credentials — isi bila tersedia:
# SAPA_TOKEN_URL="https://sapa.acehtengahkab.go.id/oauth/token"
# SAPA_API_URL="https://sapa.acehtengahkab.go.id/api"
# SAPA_CLIENT_ID=""
# SAPA_CLIENT_SECRET=""

# ─── AI / LLM (OpenAI-compatible) ───
# Contoh provider:
#   OpenRouter  https://openrouter.ai/api/v1
#   Groq        https://api.groq.com/openai/v1
#   DeepSeek    https://api.deepseek.com/v1
#   OpenAI      https://api.openai.com/v1
AI_BASE_URL="https://openrouter.ai/api/v1"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"

# ─── Vector DB (Qdrant) — OPSIONAL ───
# RAG saat ini nonaktif (rag-retriever.ts masih stub). Biarkan kosong.
# QDRANT_URL="http://localhost:6333"

# ─── Mode data ───
# true  = pakai data mock untuk demo
# false = pakai SAPA + AI sungguhan
# CATATAN: mode mock saat ini belum konsisten di semua endpoint
#          (lihat LAPORAN_AUDIT_PRODUCTION_READINESS.md §P1-04 — dijadwalkan Sprint 1)
USE_MOCK_DATA=false
