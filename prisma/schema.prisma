generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Metadata SKPK/OPD ───
model Skpd {
  id        String   @id @default(cuid())
  kode      String   @unique
  nama      String
  kategori  KategoriSkpd
  alamat    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  datasets  Dataset[]
}

enum KategoriSkpd {
  DINAS
  BADAN
  KANTOR
  SEKRETARIAT
  KECAMATAN
  PUSKESMAS
  LAINNYA
}

model Dataset {
  id              String          @id @default(cuid())
  skpdId          String
  skpd            Skpd            @relation(fields: [skpdId], references: [id])
  nama            String
  slug            String          @unique
  deskripsi       String?
  schema          Json
  endpointSplp    String?
  refreshInterval Int?
  isActive        Boolean         @default(true)
  lastSync        DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  records         DatasetRecord[]
  indicators      Indicator[]
}

model DatasetRecord {
  id        String   @id @default(cuid())
  datasetId String
  dataset   Dataset  @relation(fields: [datasetId], references: [id])
  data      Json
  periode   String
  checksum  String?
  fetchedAt DateTime @default(now())
}

model Indicator {
  id          String      @id @default(cuid())
  datasetId   String
  dataset     Dataset     @relation(fields: [datasetId], references: [id])
  nama        String
  satuan      String
  threshold   Float?
  direction   Direction   @default(STABLE)
  isKunci     Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  alerts      EwsAlert[]

  // PR Lapis 2: identitas katalog yang stabil untuk upsert (EWS menaut ke sini)
  @@unique([datasetId, nama, satuan])
}

enum Direction {
  UP_BAD
  UP_GOOD
  STABLE
}

model ChatSession {
  id         String   @id @default(cuid())
  userId     String?
  query      String
  intent     String?
  aiResponse Json?
  metadata   Json?
  createdAt  DateTime @default(now())
}

// ─── Admin Auth ───
model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String   // bcrypt hash
  nama      String
  role      AdminRole @default(ADMIN)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

enum AdminRole {
  ADMIN
  SUPERADMIN
}

// ─── Data Warehouse SAPA (PR Lapis 2) ───
// Snapshot append-only dari payload SAPA: satu baris SapaSnapshot per sinkronisasi
// yang BERUBAH (checksum), plus satu baris SapaIndicatorValue per record.
// Inilah fondasi tren historis, EWS, dan (Lapis 3) provenance multi-sumber.
model SapaSnapshot {
  id           String              @id @default(cuid())
  origin       String // 'direct' | 'splp'
  totalRecords Int
  checksum     String
  createdAt    DateTime            @default(now())
  values       SapaIndicatorValue[]

  @@index([createdAt])
}

model SapaIndicatorValue {
  id                 String       @id @default(cuid())
  snapshotId         String
  snapshot           SapaSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  idKodeIndikator    Int
  kodeIndikator      String?
  indikator          String
  opd                String
  idOpd              Int
  nilai              String
  nilaiNumber        Float?
  satuan             String
  tahun              String?
  tahunNumber        Int?
  jadwalPemutakhiran String?

  @@index([snapshotId])
  @@index([idKodeIndikator, snapshotId])
  @@index([opd])
}

model EwsAlert {
  id          String   @id @default(cuid())
  indicatorId String
  indicator   Indicator @relation(fields: [indicatorId], references: [id])
  nilaiAktual Float
  threshold   Float
  pesan       String
  severity    Severity @default(WARNING)
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
}

enum Severity {
  INFO
  WARNING
  CRITICAL
}
