generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model ChatSession {
  id         String   @id @default(cuid())
  userId     String?
  query      String
  intent     String?
  aiResponse Json?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([intent])
}

model Admin {
  id        String    @id @default(dbgenerated("gen_random_uuid()"))
  username  String    @unique
  password  String
  nama      String
  role      AdminRole @default(ADMIN)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
}

model EwsAlert {
  id                 String             @id @default(cuid())
  thresholdId        String
  indicatorId        Int
  nilaiAktual        Float
  batas              Float
  pesan              String
  severity           Severity           @default(WARNING)
  tahun              String?
  resolvedAt         DateTime?
  createdAt          DateTime           @default(now())
  indicator          SapaIndicator      @relation(fields: [indicatorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  IndicatorThreshold IndicatorThreshold @relation(fields: [thresholdId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([indicatorId])
  @@index([resolvedAt, severity])
}

model IndicatorThreshold {
  id            String            @id
  indicatorId   Int
  operator      ThresholdOperator
  nilai         Float
  severity      Severity          @default(WARNING)
  pesan         String?
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @default(now())
  EwsAlert      EwsAlert[]
  SapaIndicator SapaIndicator     @relation(fields: [indicatorId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([indicatorId, operator, nilai])
  @@index([isActive])
}

model SapaIndicator {
  id                 Int                  @id
  kode               String?
  nama               String
  satuan             String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now())
  alerts             EwsAlert[]
  IndicatorThreshold IndicatorThreshold[]
  SapaObservation    SapaObservation[]

  @@index([nama])
}

model SapaObservation {
  id            String        @id
  indicatorId   Int
  opdId         Int
  tahun         String?
  nilaiTeks     String
  nilaiNumerik  Float?
  satuan        String?
  jadwal        String?
  fetchedAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now())
  SapaIndicator SapaIndicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  SapaOpd       SapaOpd       @relation(fields: [opdId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([indicatorId, opdId, tahun])
  @@index([indicatorId, tahun])
  @@index([opdId])
}

model SapaOpd {
  id              Int               @id
  nama            String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now())
  SapaObservation SapaObservation[]

  @@index([nama])
}

model SapaSyncRun {
  id             String     @id
  startedAt      DateTime   @default(now())
  finishedAt     DateTime?
  status         SyncStatus @default(RUNNING)
  recordCount    Int        @default(0)
  opdCount       Int        @default(0)
  indicatorCount Int        @default(0)
  alertsCreated  Int        @default(0)
  durationMs     Int?
  error          String?

  @@index([startedAt])
}

enum AdminRole {
  ADMIN
  SUPERADMIN
}

enum Severity {
  INFO
  WARNING
  CRITICAL
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum ThresholdOperator {
  GT
  GTE
  LT
  LTE
}

model DataSource {
  id              String   @id @default(cuid())
  slug            String   @unique
  nama            String
  sensitivity     String   @default("PUBLIC")
  provenanceLabel String?
  ownerInstansi   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DtsenRelease {
  id            String    @id
  releaseNumber String
  status        String    @default("STAGING")
  metadata      Json?
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  individu      DtsenIndividu[]
  aggregat      DtsenAgregatWilayah[]
}

model DtsenIndividu {
  id           String   @id @default(cuid())
  releaseId    String
  nikHash      String
  namaMasked   String
  kecamatan    String?
  desa         String?
  desil        Int?
  bansos       Boolean  @default(false)
  createdAt    DateTime @default(now())

  release      DtsenRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@index([releaseId, nikHash])
}

model DtsenAgregatWilayah {
  id               String   @id @default(cuid())
  releaseId        String
  kecamatan        String?
  desa             String?
  desil            Int?
  jiwa             Int?
  kk               Int?
  pkh              Int?
  bpnt             Int?
  pbi_kredit       Int?
  pbi_nonkredit    Int?
  createdAt        DateTime @default(now())

  release          DtsenRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@index([releaseId, kecamatan])
}

model DataAccessAudit {
  id         String   @id @default(cuid())
  adminId    String?
  action     String
  detail     String   @default("")
  rowCount   Int      @default(0)
  ip         String?
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}
